<Project Sdk="Microsoft.NET.Sdk">

	<!-- TargetFramework, Nullable, ImplicitUsings, LangVersion и анализаторы —
	     централизованно в Directory.Build.props -->

	<PropertyGroup>
		<RepositoryUrl>https://github.com/andrey-aka-skif/AndreyAkaSkif.ServiceResult</RepositoryUrl>
		<GeneratePackageOnBuild>True</GeneratePackageOnBuild>
	</PropertyGroup>

	<PropertyGroup>
		<!-- Версия задаётся из релизного тега в CI (dotnet pack -p:Version=...);
		     в исходнике не хранится -->
		<Authors>andrey-aka-skif</Authors>
	</PropertyGroup>

	<PropertyGroup>
		<Title>Result-паттерн для сервисного слоя .NET</Title>
		<Product>AndreyAkaSkif ServiceResult</Product>
		<Description>Реализация Result-паттерна для сервисного слоя .NET: типизированный результат операции (успех/ошибка) без исключений, плюс набор конкретных CRUD-результатов (Success, Created, Updated, NoContent, Invalid, NotFound, Conflict) как точка маппинга в HTTP.</Description>
		<PackageTags>result;result-pattern;service-result;service-layer;dotnet;csharp</PackageTags>
		<PackageLicenseExpression>MIT</PackageLicenseExpression>
		<PackageProjectUrl>https://andrey-aka-skif.github.io/AndreyAkaSkif.ServiceResult/</PackageProjectUrl>
		<PackageReadmeFile>README.md</PackageReadmeFile>
		<RepositoryType>git</RepositoryType>
	</PropertyGroup>

	<ItemGroup>
		<None Include="..\..\README.md" Pack="true" PackagePath="\" />
	</ItemGroup>

</Project>
