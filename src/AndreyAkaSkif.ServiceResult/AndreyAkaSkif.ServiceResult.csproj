<Project Sdk="Microsoft.NET.Sdk">

	<!-- TargetFramework, Nullable, ImplicitUsings, LangVersion и анализаторы —
	     централизованно в Directory.Build.props -->

	<PropertyGroup>
		<RepositoryUrl>https://github.com/andrey-aka-skif/AndreyAkaSkif.ServiceResult</RepositoryUrl>
		<GeneratePackageOnBuild>True</GeneratePackageOnBuild>
	</PropertyGroup>

	<PropertyGroup>
		<!-- Версия задаётся из релизного тега в CI (dotnet pack -p:Version=...);
		     в исходнике не хранится -->
		<Authors>andrey-aka-skif</Authors>
	</PropertyGroup>

</Project>
